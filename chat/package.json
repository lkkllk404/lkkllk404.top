{
  "name": "chat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:worker\" \"pnpm dev:frontend\"",
    "remote-dev": "concurrently \"pnpm dev:remote-worker\" \"pnpm dev:frontend\"",
    "dev:worker": "wrangler dev --ip 0.0.0.0",
    "dev:remote-worker": "wrangler dev --ip 0.0.0.0 --remote",
    "dev:frontend": "vite dev --config vite.config.ts",
    "typecheck": "pnpm typecheck:worker && pnpm typecheck:frontend",
    "typecheck:worker": "tsc --noEmit -p tsconfig.json",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "build": "pnpm typecheck && pnpm build:frontend && pnpm build:worker",
    "build:frontend": "vite build --config vite.config.ts",
    "build:worker": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply chat-history --local",
    "db:migrate:remote": "wrangler d1 migrations apply chat-history --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250301.0",
    "concurrently": "^9.1.0",
    "vite": "^6.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "wrangler": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
