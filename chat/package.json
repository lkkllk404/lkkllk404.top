{
  "name": "chat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:worker\" \"pnpm dev:frontend\"",
    "dev:worker": "wrangler dev",
    "dev:frontend": "vite dev --config vite.config.ts",
    "build": "pnpm build:frontend && pnpm build:worker",
    "build:frontend": "vite build --config vite.config.ts",
    "build:worker": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250301.0",
    "concurrently": "^9.1.0",
    "vite": "^6.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "wrangler": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
