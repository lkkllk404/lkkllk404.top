---
import Layout from '../Layout.astro'
import profile from '../content/profile.json'
---

<Layout title="Home" currentPage="home">
  <section class="introduction" aria-labelledby="profile-name">
    <h1 id="profile-name">{profile.name}</h1>
    <div class="bio">
      {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {profile.links.length > 0 && (
      <ul class="profile-links" aria-label="公开账号与联系方式">
        {profile.links.map((link) => (
          <li>
            {link.url ? <a href={link.url}>{link.label}</a> : <span class="secondary">{link.label}</span>}
          </li>
        ))}
      </ul>
    )}
  </section>

  {profile.experience.length > 0 && (
    <section class="profile-section" aria-labelledby="experience-title">
      <h2 id="experience-title">经历</h2>
      <ul class="record-list">
        {profile.experience.map((entry) => (
          <li class="record">
            <span class="record-period">{entry.period}</span>
            <div>
              <h3>{entry.title}</h3>
              {entry.description && <p class="record-description">{entry.description}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

</Layout>
