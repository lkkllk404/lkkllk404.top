---
import '../styles/global.css'

export interface Props {
  title: string
  bodyClass?: string
}
const { title, bodyClass = '' } = Astro.props
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/avater.png" />
    <link rel="apple-touch-icon" href="/avater.png" />
    <title>{title} - lkkllk404.top</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
